{
  "name": "@hopeio/utils",
  "version": "0.0.7",
  "description": "javascript utils",
  "type": "module",
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "exports": {
    "./package.json": "./package.json",
    "./types": {
      "types": "./src/types/index.d.ts",
      "import": "./src/types/index.d.ts",
      "default": "./src/types/index.d.ts"
    },
    "./*/*": {
      "types": "./src/*/*/index.ts",
      "import": "./src/*/*/index.ts",
      "default": "./src/*/*/index.ts"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "import": "./src/*/index.ts",
      "default": "./src/*/index.ts"
    }
  },
  "typesVersions": {
    "*": {
      "types": [
        "src/types/index.d.ts"
      ],
      "*/*": [
        "src/*/*/index.ts"
      ],
      "*": [
        "src/*/index.ts"
      ]
    }
  },
  "scripts": {
    "upgrade": "pnpm update --latest",
    "link": "pnpm link --global",
    "build": "vite build",
    "test": "vitest",
    "oxlint": "oxlint ./src",
    "fmt": "oxfmt ./src",
    "fmt:check": "oxfmt --check ./src",
    "pub": "npm publish --access public"
  },
  "files": [
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hopeio/diamond.git"
  },
  "keywords": [
    "diamond"
  ],
  "author": "liov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hopeio/diamond/issues"
  },
  "homepage": "https://github.com/hopeio/diamond#readme",
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "dayjs": "^1.11.21",
    "localforage": "^1.10.0",
    "qs": "^6.15.3",
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.32",
    "@types/node": "^26.1.2",
    "@types/qs": "^6.15.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.10"
  }
}
